<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Le manifeste de confidentialité de l'app (19/10/2026), exigé par App Store
  Connect. Il dit trois choses :

  1. MemoBook ne suit personne : aucun SDK publicitaire ni d'analytique
     (voir la mémoire « ATT au frais » : les étiquettes « Used for Tracking »
     d'App Store Connect doivent rester décochées) ;
  2. les données que l'app recueille, toutes liées au compte et toutes pour le
     fonctionnement de l'app — elles doivent dire la même chose que les
     étiquettes de confidentialité d'App Store Connect ;
  3. la seule API « à raison déclarée » qu'elle appelle : UserDefaults
     (`@AppStorage`), pour ses propres réglages — raison CA92.1.

  Stripe et Google Sign-In apportent leurs propres manifestes. Une nouvelle API
  de la liste d'Apple (dates de fichiers, temps depuis le démarrage, espace
  disque) se déclare ici avant l'archive.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeName</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
