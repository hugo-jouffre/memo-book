<?xml version="1.0" encoding="utf-8"?>
<!-- Rien ne part dans la sauvegarde Google ni d'un téléphone à l'autre. Le
     jeton de session sera chiffré par une clé du Keystore, qui, elle, ne
     voyage pas : restauré ailleurs, il serait illisible. Ce que le compte
     possède est au serveur ; on se reconnecte. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
