// MemoBook — modèle de données du cœur produit :
// raconter (Entry) → transcrire → rédiger → relire → structurer → imprimer.
//
// Deux passes de modèle, volontairement séparées :
//   1. `redact` écrit le texte d'une étape, une étape à la fois, en suivant
//      `agents/agent-transcription.md`. L'utilisateur relit et corrige.
//   2. `structure` met en page le texte *validé*, en suivant
//      `templates/travel-journal/LAYOUT_KB.md`. Il ne réécrit rien.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Statut partagé par tout ce qui traverse le pipeline. C'est exactement ce que
/// l'app iOS affiche et interroge.
enum Status {
  pending
  processing
  ready
  failed
}

enum EntryKind {
  audio
  text
  photo
}

/// Les fournisseurs d'identité tiers acceptés.
enum AuthProvider {
  apple
  google
}

/// Où en est une invitation. `invited` couvre le cas d'une adresse conviée
/// avant que la personne n'ait de compte : `accountId` est alors nul.
/// Le genre déclaré depuis le profil. `undisclosed` est un **choix** — « je ne
/// préfère pas répondre » —, distinct de la colonne nulle, qui veut dire qu'on
/// n'a pas demandé.
enum Gender {
  female
  male
  undisclosed
}

enum MemoMemberStatus {
  invited
  active
  removed
}

/// Où en est le voyage. C'est cette valeur, et non l'ordre de la liste, qui
/// range un voyage dans « à venir », « en cours » ou « précédents ».
enum TripStage {
  upcoming
  ongoing
  past
}

/// Comment on est allé d'une étape à la suivante.
enum TripTransport {
  walk
  bike
  car
  bus
  train
  boat
  plane
}

/// Verdict du contrôle qualité d'une photo — `docs/photos.md` § 1.
/// Jamais un simple rejet : une photo écartée n'est pas supprimée, elle est
/// déplacée vers un emplacement plus petit ou signalée à l'utilisateur.
enum PhotoVerdict {
  ok
  upscale
  downgrade
  reject
}

/// Le coin où poser le scotch, choisi par la détection de visages plutôt qu'au
/// hasard — sans quoi il finit un jour sur un visage.
enum TapeCorner {
  top_left
  top_right
  bottom_left
  bottom_right
}

/// Qui parle dans la conversation. Au nom près de `ChatAuthor` côté Swift
/// (`MemoBookCore/Chat.swift`).
enum ChatAuthor {
  memo
  traveller
}

/// La forme d'une bulle. Au nom près de `ChatMessageBody.kind` côté Swift :
/// c'est ce que le décodeur lit dans `body.kind`.
enum ChatMessageKind {
  text
  voice
  transcript
  photos
}

/// Ce que MEMO a fait d'un tour du voyageur. Nul pour une bulle de MEMO.
///
/// `memory` : le tour raconte un souvenir — une `Entry` existe pour lui.
/// `context` : le tour précise le souvenir en cours (« oui c'était mardi avec
/// Clara ») — il n'entre pas seul dans le carnet, la rédaction le relit.
/// `command` : une puce (« Ça me convient »), un refus, une question sur l'app.
enum ChatDisposition {
  memory
  context
  command
}

/// La nature d'une écriture de cagnotte. Il n'y a pas d'état « en attente » :
/// une écriture n'existe qu'une fois l'argent réellement mouvementé.
enum WalletEntryKind {
  /// Rechargement, encaissé par Stripe.
  topup
  /// Remboursement d'une commande.
  refund
  /// Paiement d'une commande d'impression.
  order_payment
  /// Crédit offert par MemoBook (geste commercial, parrainage).
  gift
  /// Correction manuelle du support. Toujours motivée par `label`.
  adjustment
}

enum SubscriptionProvider {
  storekit
  stripe
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  cancelled
  expired
}

enum ExpenseSource {
  manual
  tricount
}

/// La forme d'une question de la modale d'avis — voir `feedback_campaigns`.
enum FeedbackQuestionKind {
  /// Zone de texte libre.
  text
  /// Liste d'options, une seule réponse.
  choice
  /// Curseur gradué entre deux bornes.
  slider
  /// Note en étoiles.
  rating
}

/// Une personne. C'est ce qui possédera les carnets quand la propriété passera
/// de l'appareil au compte.
///
/// L'email est unique mais facultatif : une personne entrée par Apple avec
/// l'adresse masquée n'en a pas d'utilisable, et on ne veut pas lui inventer
/// une identité pour satisfaire une contrainte.
model Account {
  id              String    @id @default(uuid())
  email           String?   @unique
  /// Renseigné quand un fournisseur nous a certifié l'adresse, ou après un
  /// lien de confirmation. C'est la condition du rattachement automatique
  /// entre deux fournisseurs : voir `findOrCreateAccount`.
  emailVerifiedAt DateTime?
  firstName       String?
  lastName        String?
  /// `scrypt` — voir `lib/password.ts`. Nul pour un compte qui n'entre que par
  /// Apple ou Google.
  passwordHash    String?

  phoneNumber      String?
  /// L'URL d'une photo venue d'un fournisseur (Apple, Google). Elle s'efface
  /// devant `avatarStorageKey` dès qu'on a envoyé la sienne.
  avatarUrl        String?
  /// La photo envoyée depuis le profil, dans le stockage des médias
  /// (`avatars/<uuid>.jpg`). L'app la lit par `GET /v1/avatars/:file` — voir
  /// `services/avatars.ts` pour la raison de ne pas garder une URL.
  avatarStorageKey String?

  /// Ce que la personne a dit d'elle-même — femme, homme, ou qu'elle préfère ne
  /// pas répondre. **Nul tant qu'elle n'a rien dit** : l'app accorde alors sur
  /// ce que le prénom laisse deviner (`services/genderInference.ts`), et c'est
  /// le profil qui permet de corriger. Ne sert qu'à accorder deux ou trois mots
  /// (« Abonnée ») ; rien d'autre ne le lit.
  gender Gender?

  wantsNewsletter Boolean @default(false)

  /// L'écran de bienvenue ne se montre qu'une fois. Le retenir ici plutôt que
  /// dans l'app le fait survivre à une réinstallation.
  welcomeScreenSeenAt DateTime?

  /// Adresse de livraison par défaut, celle que le profil affiche et corrige.
  /// Elle **pré-remplit** une commande, elle ne la remplace pas : `print_orders`
  /// garde sa propre copie, figée le jour de l'envoi. Corriger son adresse ne
  /// doit pas réécrire celle d'un colis déjà parti.
  addressLine1      String?
  addressLine2      String?
  addressPostalCode String?
  addressCity       String?
  addressCountry    String?

  /// Le client Stripe correspondant. C'est lui qui porte les moyens de paiement
  /// et les abonnements ; rien de sensible ne descend jusqu'ici.
  stripeCustomerId String? @unique

  /// Solde de la cagnotte, **en centimes**, et jamais en flottant.
  ///
  /// C'est un cache : la vérité est la somme de `wallet_entries`. Il est
  /// recalculé dans la même transaction que l'écriture qui le déplace, et
  /// `WalletEntry.balanceAfterCents` permet de vérifier à tout moment qu'il n'a
  /// pas dérivé.
  walletBalanceCents Int @default(0)

  /// Les étapes offertes à l'ouverture du compte, et celles qui restent.
  /// Les deux, et non un seul : c'est leur écart qui change le message de
  /// l'accueil. Nuls pour un compte sans quota, un abonné par exemple.
  offeredSteps   Int?
  remainingSteps Int?

  /// **Les limites de souvenirs**, en « souvenirs » consommés dans le mois.
  ///
  /// À ne pas confondre avec les étapes offertes ci-dessus, qui sont le palier
  /// d'entrée : celles-là s'épuisent une fois et ouvrent le paywall. Les
  /// limites de souvenirs, elles, sont le budget **mensuel** de quelqu'un qui
  /// raconte déjà — elles se rechargent, et se relèvent contre 3,99 €/mois.
  ///
  /// Un vocal coûte plus cher qu'un message, parce qu'il coûte plus cher :
  /// transcription, rédaction, relecture. La table des coûts vit dans
  /// `services/memoryAllowance.ts`, pas ici — une règle de tarification ne se
  /// range pas dans un schéma.
  memoryPlan        MemoryPlan @default(included)
  /// Combien de souvenirs ont été consommés depuis `memoryPeriodStart`.
  memoryUsed        Int        @default(0)
  /// Le début du mois glissant en cours. Le budget se remet à zéro au premier
  /// usage qui suit son échéance — un mois glissant et non calendaire, pour
  /// qu'un compte ouvert le 28 n'ait pas trois jours de budget.
  memoryPeriodStart DateTime   @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  identities     Identity[]
  sessions       Session[]
  devices        Device[]
  passwordResets PasswordReset[]

  ownedMemos        Memo[]             @relation("MemoOwner")
  printOrders       PrintOrder[]       @relation("PrintOrderBuyer")
  memberships       MemoMember[]
  walletEntries     WalletEntry[]
  cards             PaymentCard[]
  subscriptions     Subscription[]
  connectors        AccountConnector[]
  feedbackResponses FeedbackResponse[]
  chatMessages      ChatMessage[]

  @@map("accounts")
}

/// Une demande de « mot de passe oublié » : le secret envoyé par e-mail, haché
/// comme un token de session, et qui ne vaut qu'une fois et qu'un moment.
///
/// Une ligne par demande, jamais mise à jour en place : redemander l'e-mail
/// crée une nouvelle ligne et **retire** les précédentes, si bien qu'un seul
/// secret est valable à la fois. `usedAt` reste pour l'audit — on veut pouvoir
/// dire « ce mot de passe a été changé par ce chemin, à cette heure ».
model PasswordReset {
  id        String  @id @default(uuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  /// SHA-256 du secret envoyé — le secret en clair n'existe que dans l'e-mail.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([accountId])
  @@map("password_resets")
}

/// Le lien entre un compte et un fournisseur tiers. Un compte peut en avoir
/// plusieurs : la même personne entrée par Apple puis par Google.
model Identity {
  id        String  @id @default(uuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  provider AuthProvider
  /// Le `sub` du jeton. Stable, propre à notre app, et jamais réattribué.
  subject  String
  /// L'adresse telle que le fournisseur l'a donnée au moment du lien. Gardée
  /// pour le support : celle du compte peut diverger.
  email    String?

  createdAt DateTime @default(now())

  /// Deux comptes ne peuvent pas revendiquer le même `sub` chez un fournisseur.
  @@unique([provider, subject])
  @@index([accountId])
  @@map("identities")
}

/// Une session ouverte. Le token est opaque et haché, comme celui des
/// appareils : révoquer, c'est supprimer une ligne — pas attendre l'expiration
/// d'un JWT qu'on ne contrôle plus une fois émis.
model Session {
  id        String  @id @default(uuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  /// SHA-256 du token porteur — le token en clair n'existe que dans l'app.
  tokenHash  String   @unique
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime

  @@index([accountId])
  @@map("sessions")
}

/// Identité provisoire, le temps que la vraie authentification arrive.
/// Un appareil s'enregistre une fois et conserve son token.
model Device {
  id         String   @id @default(uuid())
  /// SHA-256 du token porteur — le token en clair n'existe que dans l'app.
  tokenHash  String   @unique
  platform   String   @default("ios")
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  /// Le compte auquel cet appareil s'est rattaché, une fois son porteur
  /// identifié. Nul tant qu'il n'y a pas eu de connexion.
  ///
  /// Un appareil ne **possède** plus rien : c'est une trace d'installation, pas
  /// un propriétaire. Il disparaît avec le compte auquel il est rattaché — un
  /// compte supprimé ne laisse pas derrière lui un jeton qui ouvrirait encore
  /// quelque chose.
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("devices")
}

/// Un projet de carnet : « Notre tour du monde », « La première année de Jeanne ».
/// C'est ce que l'app appelle un **voyage**.
model Memo {
  id String @id @default(uuid())

  /// **Le** propriétaire, et la seule vérité sur la propriété.
  ///
  /// Obligatoire : un carnet sans propriétaire principal n'existe pas. C'est ce
  /// qui a fait disparaître les deux autres façons de dire à qui était un
  /// carnet — un `deviceId` hérité de l'époque sans comptes, et une ligne
  /// `memo_members` de rôle `owner`. Trois vérités pour un même fait, dont deux
  /// pouvaient diverger en silence.
  ///
  /// En cascade : supprimer un compte supprime ses carnets, et tout ce qui y
  /// pend (souvenirs, médias, étapes, dépenses, rendus, invitations).
  ownerAccountId String
  owner          Account @relation("MemoOwner", fields: [ownerAccountId], references: [id], onDelete: Cascade)

  title         String
  subtitle      String?
  /// Ligne d'auteurs telle qu'elle s'imprime en couverture. Ce n'est **pas** la
  /// liste des participants : celle-là vit dans `memo_members`.
  authors       String?
  /// Thème narratif saisi par l'utilisateur (voyage, naissance, projet…).
  theme         String?
  startDate     DateTime?
  endDate       DateTime?
  /// Photo de couverture (URL CDN publique).
  coverPhotoUrl String?

  /// Style de carnet retenu (voir `agents/carnet-styles/`).
  styleKey String?

  /// Fiche de cohérence du carnet — `agents/agent-transcription.md` § 2.
  /// Noms propres, appellations, temps du récit, « on » ou « nous », unités,
  /// formats. L'agent de rédaction la relit avant chaque étape et la complète
  /// après : c'est ce qui fait que la page 20 parle comme la page 2.
  coherenceSheet Json?

  // --- La conversation avec MEMO — `docs/conversation.md` ------------------

  /// Ce que MEMO retient d'un tour à l'autre et qui n'est pas un message :
  /// les journées dont il a déjà demandé la rose, l'épine et la graine
  /// (`roseEpineGraineAskedFor: ["2026-09-21"]`). JSON libre relu
  /// défensivement, comme `coherenceSheet` — forme : `ConversationState` dans
  /// `services/conversation.ts`.
  conversationState Json?

  /// « Supprimer la conversation » : depuis quand le fil repart de la bulle
  /// d'ouverture. Les souvenirs d'avant restent dans le carnet mais ne
  /// reviennent pas dans le fil — sans cette borne, la reconstruction depuis
  /// `entries` les y reposerait à la lecture suivante.
  chatClearedAt DateTime?

  // --- Le voyage tel que l'accueil le montre -------------------------------

  /// Rangé par cette valeur, pas par l'ordre de la liste.
  stage TripStage @default(ongoing)

  /// Le pays. Le drapeau se **dérive** du code ISO 3166-1 alpha-2 : aucun emoji
  /// n'est stocké.
  destinationName        String?
  destinationCountryCode String?

  /// La ville — « Rome ». Distincte du pays et du titre du carnet : c'est elle
  /// qu'on emploie pour s'adresser au voyageur (« Nouveau voyage à Rome ! »),
  /// là où le pays donnerait « à Italie » et le titre une phrase entière.
  /// Nulle pour un carnet qui n'est pas situé dans une ville.
  destinationCity String?

  /// Compteurs affichés sous le titre. Entretenus à l'écriture plutôt que
  /// recalculés à chaque ouverture de l'accueil, qui les demande tous d'un coup
  /// pour tous les voyages.
  dayCount           Int?
  distanceKilometres Float?
  photoCount         Int?

  /// La barre de progression : deux compteurs et une cible, jamais un
  /// pourcentage. « 2 / 80 pages » se lit, « 2,5 % » ne dit rien.
  memoryCount Int @default(0)
  pageCount   Int @default(0)

  /// Le carnet est généré et peut partir à l'impression.
  isPrintable Boolean @default(false)

  /// Le code d'accès du voyage : celui qu'on lit à voix haute, qu'on colle dans
  /// un message, et qui fait entrer quelqu'un dans le carnet — la dernière
  /// étape de la création ne montre que lui.
  ///
  /// Six caractères d'un alphabet **sans ambiguïté** : ni O ni 0, ni I ni 1.
  /// Un code se recopie à la main, et « JHKFDA » ne doit avoir qu'une seule
  /// lecture possible.
  ///
  /// Unique et obligatoire : c'est lui, et non l'identifiant, qui désigne le
  /// voyage qu'on rejoint. Un voyage sans code serait un voyage qu'on ne peut
  /// pas partager, or tous peuvent l'être.
  accessCode String @unique

  /// La relance de MemoBook — « Comment ça se passe à Trastevere ? ». Écrite à
  /// partir de ce qui a déjà été raconté, donc en base et pas dans l'app.
  prompt String?

  /// Rythme du récit, « tous les 2 jours ». Cadence les relances.
  narrationPace String?

  /// Le titre que le **récit** se donne — « Rome et la Dolce Vita ».
  ///
  /// Distinct de `title`, qui est le nom du voyage (« Rome 2026 ») : le
  /// premier est une couverture de carnet, le second une entrée de liste. Nul
  /// tant que le récit ne s'est pas nommé ; l'aperçu retombe alors sur `title`.
  bookTitle String?

  /// Les relances de **ce voyage-ci**.
  ///
  /// Rien à voir avec l'autorisation système, qui est globale et vit dans iOS :
  /// couper ici n'enlève aucune permission, ça arrête les relances de ce
  /// carnet. C'est pour ça que l'écran de réglages porte les deux lignes,
  /// l'interrupteur et « Gérer mes notifications ».
  notificationsEnabled Boolean @default(true)

  // --- Le détail des alertes — feuille « Notifications » ---------------------
  //
  // Quatre drapeaux, et non un seul : `notificationsEnabled` coupe tout d'un
  // coup depuis la ligne des réglages, ceux-ci disent *quoi* recevoir quand il
  // est levé. Sans eux, la feuille « Gérer mes notifications » proposait un
  // réglage fin que rien ne retenait — exactement ce que
  // `docs/reglages-utilisateur.md` interdit.

  /// « Rappel d'écriture » — la relance calée sur `narrationPace`.
  notifyWritingReminder Boolean @default(true)
  /// « Nouveau récit » — un co-voyageur a alimenté le carnet.
  notifyNewStory        Boolean @default(true)
  /// « Résumé hebdomadaire » — un point sur les souvenirs capturés.
  notifyWeeklyDigest    Boolean @default(true)
  /// « Rappel de fin de voyage » — l'alerte qui dit de valider l'impression.
  notifyTripEnd         Boolean @default(true)

  /// Le lien de prévisualisation publique, celui qu'on envoie à ses proches.
  ///
  /// **Nul par défaut, et c'est le point** : c'est un lien public, il ne se
  /// crée pas à la création d'un voyage. Il n'existe qu'à partir du moment où
  /// quelqu'un a demandé à partager, depuis la feuille « Partager ton
  /// MemoBook ». Unique, parce que c'est lui — et non l'identifiant — qui
  /// désigne le carnet à quelqu'un qui n'a pas de compte.
  ///
  /// Distinct d'`accessCode`, qui fait **entrer** dans le voyage : celui-ci ne
  /// donne qu'à lire l'aperçu.
  shareSlug String? @unique

  /// Partager sur la galerie. Un carnet public passe une modération plus
  /// stricte avant d'y entrer.
  ///
  /// C'est **le seul** critère d'entrée dans l'écran « Exemples de carnets » :
  /// `GET /v1/gallery` ne sert que des carnets qui portent ce drapeau.
  isPublicGallery Boolean @default(false)

  /// La phrase sous le titre, sur la carte de la galerie : « 2 semaines de
  /// trek », « Un couple autour du monde ».
  ///
  /// Elle **ne se saisit pas** : elle sera déduite du contenu du voyage par un
  /// agent, comme `prompt` et `coherenceSheet` le sont déjà. La colonne existe
  /// avant l'agent parce que la carte, elle, la montre dès aujourd'hui —
  /// l'écran s'en passe (`null` : seul le titre s'affiche), il ne l'invente
  /// pas. Distincte de `subtitle`, qui est le sous-titre **imprimé en
  /// couverture** du carnet : deux textes, deux lecteurs, deux longueurs.
  gallerySummary String?

  // --- Personnalisations — `docs/reglages-utilisateur.md` -------------------
  //
  // Réglages du carnet, portés par le carnet lui-même : il y en a exactement un
  // jeu par voyage, ils se lisent toujours avec lui, et aucune requête ne les
  // interroge seuls. Une table à part n'aurait ajouté qu'une jointure et un cas
  // « pas encore de réglages » à traiter partout.
  //
  // Règle de survie du document : aucun réglage n'est exposé dans l'app avant
  // d'exister dans `templates/travel-journal/LAYOUT_KB.md`. Une colonne que le
  // gabarit ignore ferait croire à l'utilisateur qu'il a réglé quelque chose.

  /// Nombre de pages visé. Pilote le niveau de détail de la rédaction et le
  /// regroupement des étapes.
  targetPageCount Int @default(60)

  /// Part de photo dans la page, en pourcentage. 50 = l'équilibre de la
  /// maquette. Pilote le choix des layouts et la fréquence des pages photo.
  photoTextRatio Int @default(50)

  /// Le réglage **autorise**, il n'oblige pas : à ON, un encart toutes les
  /// trois à quatre pages, et seulement si le fait passe le seuil de
  /// pertinence.
  funFactsEnabled Boolean @default(true)

  /// Un seul bloc interactif par page, et il remplace la zone flottante du bas.
  quizEnabled Boolean @default(true)

  /// La réglure du papier, sous le texte. À OFF la page reste blanche sous le
  /// récit ; le rythme vertical, lui, ne change pas.
  rulesEnabled Boolean @default(true)

  /// Une zone blanche à la fin de chaque étape, et trois pages blanches à la
  /// fin du carnet.
  freeZonesEnabled Boolean @default(true)

  /// Mot fléché en fin de carnet, généré à la commande à partir des mots du
  /// voyage tenus dans la fiche de cohérence.
  crosswordEnabled Boolean @default(true)

  /// Décorations et stickers par paragraphe ou par image, de 0 à 4. **Le scotch
  /// des photos compte dans le quota.** À 0, aucun décor.
  decorationQuota Int @default(2)

  /// Les quatre axes typographiques, indépendants. Des chaînes et non une
  /// énumération : la liste est fermée, mais elle est fermée par ce que
  /// `templates/travel-journal/assets/fonts/` embarque réellement, et ajouter
  /// une police ne doit pas demander une migration.
  fontDisplay String @default("Playfair Display")
  fontTitle   String @default("Hansley")
  fontHand    String @default("Gloria Hallelujah")
  fontFacts   String @default("Playfair Display")

  /// Première et quatrième de couverture personnalisées. Structure libre le
  /// temps que l'éditeur de couverture existe et fixe la sienne.
  coverFront Json?
  coverBack  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries      Entry[]
  renders      Render[]
  orders       PrintOrder[]
  members      MemoMember[]
  steps        MemoStep[]
  expenses     Expense[]
  categories   MemoGalleryCategory[]
  chatMessages ChatMessage[]

  @@index([ownerAccountId, createdAt])
  /// La galerie lit **tous** les carnets publics, quel qu'en soit le
  /// propriétaire : c'est la seule requête de l'app qui ne part pas d'un
  /// compte, et sans cet index elle balaierait la table entière.
  @@index([isPublicGallery, startDate])
  @@map("memos")
}

/// Une catégorie de la galerie de la communauté : « Tour du monde »,
/// « Randonnée », « Road trip ».
///
/// **Une table et non une énumération.** Ajouter une catégorie, la renommer,
/// changer son pictogramme ou la retirer de la barre de filtres est une
/// écriture en base, pas une livraison d'app : c'est exactement le parti pris
/// de `Showcase` et de `FeedbackCampaign`, et pour la même raison — le contenu
/// éditorial bouge plus vite que le binaire.
model GalleryCategory {
  id String @id @default(uuid())

  /// L'identifiant stable, celui qu'on écrit dans un script ou une requête.
  /// `name` peut changer, `slug` non.
  slug String @unique

  /// Le libellé de la pastille de filtre, tel qu'il s'affiche.
  name String

  /// La clé du pictogramme, résolue par l'app — voir
  /// `MemoBookDesign/LucideIcon.swift` et
  /// `assets/icons/lucide-icons/README.md`. Ce n'est **pas** un nom d'asset
  /// iOS : c'est le nom du fichier source, pour qu'une clé inconnue de l'app
  /// retombe sur une boussole au lieu de casser la barre de filtres.
  iconKey String

  /// Ordre dans la barre de filtres, du plus petit au plus grand.
  position Int @default(0)

  /// Retirée de la barre sans être supprimée : les carnets qu'elle range
  /// gardent leur rattachement, et la rallumer les remet d'un coup.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memos MemoGalleryCategory[]

  @@index([isActive, position])
  @@map("gallery_categories")
}

/// Le rattachement d'un carnet à une catégorie de la galerie.
///
/// **Plusieurs par carnet**, et c'est voulu : un tour du monde à pied est aussi
/// une randonnée, et devoir choisir le rangerait mal dans l'un des deux
/// filtres. La barre, elle, ne laisse cocher qu'une catégorie à la fois — un
/// carnet apparaît alors sous chacune des siennes.
model MemoGalleryCategory {
  memoId String
  memo   Memo   @relation(fields: [memoId], references: [id], onDelete: Cascade)

  categoryId String
  category   GalleryCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([memoId, categoryId])
  @@index([categoryId])
  @@map("memo_gallery_categories")
}

/// Les **co-voyageurs** d'un voyage — jamais son propriétaire, qui est
/// `memos.ownerAccountId` et rien d'autre.
///
/// Co-voyageur et non « invité de moindre droit » : sur le voyage, **il fait
/// tout ce que fait le propriétaire** — raconter, envoyer des vocaux, changer
/// les réglages, générer le carnet, le commander. La seule chose qui reste au
/// propriétaire est de **supprimer** le voyage : il n'y a qu'un propriétaire
/// principal, et détruire le récit de tout le monde n'est pas un geste qui se
/// partage.
///
/// Ce que le lien ne partage **pas** non plus : l'argent. Cagnotte
/// (`wallet_entries`) et abonnement (`subscriptions`) pendent d'un compte, pas
/// d'un voyage — chacun a les siens, et une commande retient qui l'a passée
/// (`print_orders.orderedByAccountId`).
///
/// Il n'y a pas de table de co-voyageurs à part : un participant **est** un
/// compte. Le seul cas où il n'en a pas encore un est l'invitation en attente,
/// portée par `invitedEmail` jusqu'à ce que la personne s'inscrive — sans quoi
/// on ne pourrait convier que des gens déjà sur MemoBook.
///
/// Le propriétaire n'y a **pas** de ligne : il en avait une, de rôle `owner`,
/// et c'était une seconde vérité sur la propriété — celle que rien n'empêchait
/// de contredire la colonne. « Qui est sur ce voyage » se lit donc en deux
/// morceaux assumés : le propriétaire, puis ses co-voyageurs.
model MemoMember {
  id     String @id @default(uuid())
  memoId String
  memo   Memo   @relation(fields: [memoId], references: [id], onDelete: Cascade)

  /// Nul tant que l'invitation n'a pas trouvé son compte.
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)

  /// L'adresse conviée. Renseignée à l'invitation, conservée ensuite pour
  /// savoir par quelle adresse la personne est entrée.
  invitedEmail String?

  status MemoMemberStatus @default(invited)

  /// Nom affiché sur la pastille tant que le compte n'existe pas, ou si la
  /// personne veut apparaître autrement sur ce voyage-là.
  displayName String?
  /// Le « @clara_prn » de la maquette.
  handle      String?

  /// Ce que cette personne est pour le propriétaire — « Ton pote d'enfance ».
  ///
  /// **Personne ne le saisit.** Il est déduit par l'agent de rédaction au bout
  /// de quelques récits, comme `memos.prompt` et `memos.gallerySummary` le sont
  /// déjà : c'est la note « Logique IA 🤖 » de la maquette d'invitation. Nul
  /// tant qu'il n'y a pas eu assez de récit pour le deviner — la ligne se
  /// contente alors du nom.
  role String?

  invitedByAccountId String?

  invitedAt  DateTime  @default(now())
  acceptedAt DateTime?

  /// Une personne n'apparaît qu'une fois par voyage.
  @@unique([memoId, accountId])
  @@unique([memoId, invitedEmail])
  @@index([accountId, invitedAt])
  @@map("memo_members")
}

/// Une étape du voyage : un lieu, des dates, ceux qui y étaient.
///
/// Une étape **regroupe** des souvenirs, elle n'en est pas un. Jusqu'ici le
/// regroupement se refaisait à chaque génération à partir de `capturedAt` et
/// disparaissait ensuite ; il devient une donnée que l'utilisateur peut
/// corriger.
model MemoStep {
  id     String @id @default(uuid())
  memoId String
  memo   Memo   @relation(fields: [memoId], references: [id], onDelete: Cascade)

  /// Son rang dans le voyage. C'est lui qui nomme l'étape tant qu'elle n'a pas
  /// de titre.
  number Int

  /// Le lieu tel qu'on le dirait : « Trastevere ».
  placeName String?

  destinationName        String?
  destinationCountryCode String?

  startDate DateTime?
  endDate   DateTime?

  /// La vignette de l'étape (URL CDN publique).
  photoUrl String?

  /// Comment on est arrivé jusqu'ici.
  transport TripTransport?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries Entry[]
  chatMessages ChatMessage[]

  @@unique([memoId, number])
  @@index([memoId, startDate])
  @@map("memo_steps")
}

/// Une dépense du voyage.
///
/// Une dépense est une **métadonnée vérifiable** : elle situe une date et un
/// lieu. Elle ne raconte rien — le souvenir doit venir du voyageur.
model Expense {
  id     String @id @default(uuid())
  memoId String
  memo   Memo   @relation(fields: [memoId], references: [id], onDelete: Cascade)

  /// En centimes, comme tout montant de ce schéma.
  amountCents Int
  currency    String @default("EUR")

  label      String?
  /// L'horodatage de la dépense, pas de sa saisie : c'est lui qui la rattache à
  /// une journée du récit.
  occurredAt DateTime
  placeLabel String?

  source     ExpenseSource @default(manual)
  /// L'identifiant chez la source, quand elle en donne un. Empêche d'importer
  /// deux fois la même ligne Tricount.
  externalId String?

  createdAt DateTime @default(now())

  @@unique([source, externalId])
  @@index([memoId, occurredAt])
  @@map("expenses")
}

/// Un message de l'utilisateur : un vocal, une note écrite ou une photo.
model Entry {
  id     String @id @default(uuid())
  memoId String
  memo   Memo   @relation(fields: [memoId], references: [id], onDelete: Cascade)

  kind       EntryKind
  status     Status    @default(pending)
  /// Transcription brute. Audio : remplie par le job `transcribe`. Texte :
  /// saisie directement. Archivée telle quelle — c'est la source de vérité
  /// contre laquelle se vérifie la fidélité du texte rédigé.
  transcript String?

  /// Texte rédigé par le job `redact`, d'après `agents/agent-transcription.md`.
  redactedText    String?
  /// Statut de la passe de rédaction, suivi séparément de `status` : une
  /// transcription réussie dont la rédaction échoue reste exploitable.
  redactionStatus Status    @default(pending)
  redactionError  String?
  /// Modèle qui a rédigé, pour tracer une régression de style après un
  /// changement de modèle.
  redactionModel  String?
  redactedAt      DateTime?

  /// Texte corrigé au clavier par l'utilisateur dans l'app. Dès qu'il existe,
  /// il fait autorité : la mise en page le reprend **au mot près**.
  editedText String?
  editedAt   DateTime?

  /// Propositions de l'agent de rédaction, que la mise en page consomme.
  suggestedTitle String?
  /// Encart « Fun fact » — 140 caractères, voir LAYOUT_KB.
  funFact        String?
  funFactTitle   String?
  /// `sun` | `sun-wind` | `cloud` | `rain` | `snow`.
  weatherKey     String?

  /// Le quiz proposé pour ce souvenir. Il vit ici et non dans le payload du
  /// rendu, sinon il serait réécrit à chaque aperçu : c'est du texte que
  /// l'agent de rédaction produit une fois, au même titre que le fun fact.
  /// `quizAnswers` est un tableau de chaînes, `quizAnswerIndex` désigne la
  /// bonne dedans.
  quizQuestion    String?
  quizAnswers     Json?
  quizAnswerIndex Int?

  // --- Analyse de la photo — `docs/photos.md` ------------------------------
  //
  // Portée par le souvenir et non par le fichier : `tapeCorner` et le point de
  // focus sont des décisions de mise en page prises pour *cette* photo dans
  // *ce* carnet, pas des propriétés de l'objet stocké sur S3. Le fichier, lui,
  // ne connaît que sa clé et son poids.

  photoWidthPx  Int?
  photoHeightPx Int?

  /// Le contrôle arrive **avant** la mise en page : une photo de 73 dpi est
  /// irrattrapable une fois le livre imprimé.
  photoVerdict PhotoVerdict?

  /// Variance du laplacien, et part de pixels dans les extrêmes de
  /// l'histogramme. Seuils à calibrer sur un lot réel.
  photoSharpness Float?
  photoExposure  Float?

  /// Où poser le scotch, et où recadrer. Sans ces champs, le gabarit retombe
  /// sur un centrage neutre et un scotch en haut à gauche : jamais une erreur,
  /// seulement un rendu moins fin.
  tapeCorner TapeCorner?
  focusX     Float?
  focusY     Float?

  /// Posé par le job `memobook.enhance` après un agrandissement réussi.
  enhancedAt DateTime?

  /// Ce que l'agent de rédaction a **relevé** dans ce souvenir pour les
  /// statistiques du profil : pays, régions et villes cités, personnes
  /// rencontrées, kilomètres parcourus, moyens de transport, et l'endroit où
  /// le voyageur se trouve en le racontant. Forme : `EntryInsights` dans
  /// `services/redaction.ts`.
  ///
  /// Porté par le souvenir et non par le carnet : c'est un relevé **par
  /// étape**, que `services/travelStatistics.ts` additionne à la lecture. Un
  /// compteur tenu sur le carnet dériverait à la première correction ou
  /// suppression d'un souvenir. Nul tant que la rédaction n'est pas passée —
  /// la statistique retombe alors sur ce que le voyage déclare (destination,
  /// étapes), jamais sur zéro.
  insights Json?

  /// « Ça me convient » : le voyageur a relu le texte et le garde tel quel.
  ///
  /// Le carnet se compose avec tous les souvenirs, validés ou non — un
  /// souvenir non relu n'est pas un souvenir absent ; l'aperçu signale ceux
  /// qui ne le sont pas. C'est aussi **l'unité des étapes offertes** : une
  /// validation confirme l'étape que la création du souvenir avait réservée
  /// (`services/quota.ts`).
  validatedAt DateTime?

  /// Horodatage du souvenir lui-même, pas de l'upload — c'est lui qui sert à
  /// regrouper les entries par journée lors de la structuration.
  capturedAt DateTime @default(now())
  /// Lieu déclaré par l'app (nom lisible, ex. « Bogotá, Colombie »).
  placeLabel String?
  /// Message d'erreur du dernier échec de traitement, le cas échéant.
  error      String?

  mediaId String?
  media   MediaAsset? @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  /// L'étape à laquelle ce souvenir se rattache. Nulle tant que les étapes ne
  /// sont pas posées : le regroupement par journée reste alors celui de
  /// `capturedAt`.
  stepId String?
  step   MemoStep? @relation(fields: [stepId], references: [id], onDelete: SetNull)

  /// Les tours de conversation qui parlent de ce souvenir : celui qui l'a
  /// créé, ses précisions, et sa fiche. Voir `ChatMessage.entryId`.
  chatMessages ChatMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memoId, capturedAt])
  @@index([stepId])
  @@map("entries")
}
/// Un tour de la conversation avec MEMO — ce que le voyageur a dit, ou ce que
/// MEMO lui a répondu. `docs/conversation.md`.
///
/// **Un fil par voyage**, adossé à `memos` (§ 14.4 de `docs/ui-development.md`) :
/// les messages portent leur étape, ils ne sont pas rangés par étape. Le fil
/// est **commun aux co-voyageurs** — c'est le récit du voyage —, et chaque
/// bulle bleue retient qui l'a dite, là où `entries` reste sans auteur : le
/// souvenir appartient au récit, la phrase à celui qui l'a prononcée.
///
/// C'est aussi l'historique que MEMO relit avant de répondre (les vingt
/// derniers tours) et la reprise d'un autre appareil : rien de ce qui se dit
/// ici ne vit seulement dans l'app.
model ChatMessage {
  id     String @id @default(uuid())
  memoId String
  memo   Memo   @relation(fields: [memoId], references: [id], onDelete: Cascade)

  /// L'ordre du fil, et **la seule vérité sur l'ordre**. Une séquence
  /// Postgres, jamais `createdAt` : deux bulles de MEMO écrites dans la même
  /// transaction partagent une milliseconde, et une réponse insérée par un
  /// job ne doit jamais pouvoir passer avant la question.
  seq Int @unique @default(autoincrement())

  author ChatAuthor
  kind   ChatMessageKind

  /// Le compte qui a parlé — une bulle du voyageur seulement. `SetNull` et non
  /// `Cascade` : un compte supprimé emporte son prénom, pas les phrases qui
  /// font le récit des autres (même règle que `deletion.ts` pour les souvenirs).
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  /// Le texte d'une bulle `text`. Nul pour un vocal, une fiche ou des photos :
  /// leur contenu se lit sur le souvenir, pas ici.
  text String?

  /// Le souvenir que ce tour a **créé** (vocal, photo, texte classé `memory`),
  /// qu'il **enrichit** (`context`), ou dont il est **la fiche** (une bulle
  /// `transcript` de MEMO). Un même souvenir a donc plusieurs messages ; la
  /// fiche se redessine à chaque lecture depuis `entries`, elle ne recopie
  /// rien. `SetNull` : supprimer un souvenir laisse la conversation lisible,
  /// et le sérialiseur retire les fiches orphelines.
  entryId String?
  entry   Entry?  @relation(fields: [entryId], references: [id], onDelete: SetNull)

  /// Ce que MEMO a décidé de ce tour — voir `ChatDisposition`. Écrit par le
  /// job `converse` pour un texte libre, par la route pour un vocal, une photo
  /// (toujours `memory`) ou une puce (toujours `command`).
  disposition ChatDisposition?

  /// La puce qui a produit ce message, quand c'en est une (« accept »,
  /// « edit-hand »…). C'est ce qui permet de répondre sans modèle à une
  /// commande connue, et de ne pas lui compter un souvenir.
  suggestionId String?

  /// L'étape dont ce message parle. `SetNull` : supprimer une étape ne
  /// supprime pas ce qu'on en a dit.
  stepId String?
  step   MemoStep? @relation(fields: [stepId], references: [id], onDelete: SetNull)

  // --- Ce que seule une bulle de MEMO porte -----------------------------

  /// Le message du voyageur auquel cette bulle répond. C'est ce qui regroupe
  /// les temps d'une même réponse.
  replyToId String?

  /// Le silence avant de poser la bulle, en millisecondes — la donnée de
  /// rythme de `MemoBeat.pauseMilliseconds` côté Swift. Décidée ici, jouée
  /// par l'app.
  pauseMilliseconds Int?

  /// Qui a écrit cette bulle : `claude-sonnet-5`, `heuristic` (le repli quand
  /// le modèle ne répond pas), `fake`. Comme `entries.redactionModel` : pour
  /// tracer une régression de ton, et compter combien de fois MEMO a parlé
  /// sans modèle.
  model String?

  // --- Ce que seul un tour du voyageur porte ------------------------------

  /// L'instant où MEMO a fini de répondre. Nul tant que le job `converse`
  /// n'est pas passé : c'est **l'état « un tour est en vol »** que l'app
  /// sonde, et rien d'autre ne le tient.
  repliedAt DateTime?

  /// Ce qui n'a pas mérité une colonne : les niveaux de la forme d'onde d'un
  /// vocal (`levels`, 0 à 1), les souvenirs d'une bulle de photos (`entryIds`),
  /// les puces proposées par une bulle de MEMO (`suggestions`, des
  /// identifiants du catalogue), le sujet d'une précision
  /// (`topic: "rose_epine_graine"`). Relu défensivement, comme
  /// `memos.coherenceSheet`.
  payload Json?

  createdAt DateTime @default(now())

  /// La lecture du fil : par carnet, dans l'ordre.
  @@index([memoId, seq])
  /// Le tour en vol, et le plafond quotidien : par carnet, par auteur, par date.
  @@index([memoId, author, createdAt])
  /// Les précisions d'un souvenir, relues par la rédaction.
  @@index([entryId])
  @@map("chat_messages")
}


/// Un fichier stocké. `storageKey` pointe vers S3 (audio brut, photo originale),
/// `cdnUrl` vers Webflow une fois la photo publiée — c'est cette URL publique
/// qu'APITemplate consomme.
model MediaAsset {
  id              String  @id @default(uuid())
  storageKey      String  @unique
  mimeType        String
  bytes           Int
  /// Durée en secondes, pour les audios.
  durationSeconds Float?
  cdnUrl          String?

  /// La clé de l'original, quand `storageKey` pointe vers une version
  /// agrandie. L'original est toujours conservé : un agrandissement raté doit
  /// pouvoir être annulé.
  ///
  /// Le seul champ de l'agrandissement qui reste ici : c'est un fait sur
  /// l'objet stocké, pas sur le souvenir. Tout le reste de l'analyse photo vit
  /// sur `entries`.
  originalStorageKey String?

  createdAt DateTime @default(now())

  entries Entry[]

  @@map("media_assets")
}

/// Une génération de carnet. On en garde l'historique : chaque tentative
/// conserve son payload, ce qui rend les régressions de mise en page traçables.
model Render {
  id     String @id @default(uuid())
  memoId String
  memo   Memo   @relation(fields: [memoId], references: [id], onDelete: Cascade)

  status                   Status  @default(pending)
  /// Payload conforme à templates/travel-journal/gpt_image_schema.yaml.
  payload                  Json?
  /// Identifiant de transaction renvoyé par APITemplate.io.
  apitemplateTransactionId String?
  pdfUrl                   String?
  error                    String?

  /// Le nombre de pages réellement composées par ce rendu.
  ///
  /// ⚠️ **Orpheline** : la colonne existe en base depuis le 15/09/2026, posée
  /// par une migration dont le fichier n'a jamais été versionné, et **aucun
  /// code ne la lit ni ne l'écrit**. Les pages facturées passent par
  /// `memos.pageCount` et `print_orders.pageCount` (voir `billablePages`).
  /// Elle est déclarée ici pour que le schéma dise la vérité sur la base —
  /// sans quoi la prochaine migration proposerait de la supprimer.
  pageCount Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders PrintOrder[]

  @@index([memoId, createdAt])
  @@map("renders")
}

/// La rapidité d'acheminement choisie à l'étape 4.
///
/// Deux paliers et non un délai en jours : c'est ce que l'imprimeur vend, et
/// c'est aussi ce que l'écran propose. Les bornes réelles (`estimatedMinDays`,
/// `estimatedMaxDays`) sont posées par l'imprimeur au moment de l'expédition.
enum ShippingSpeed {
  standard
  express
}

enum PrintOrderStatus {
  draft
  submitted
  in_production
  shipped
  cancelled
}

/// Une commande de carnet imprimé, passée sur un rendu précis.
///
/// Le rendu commandé est figé : réimprimer après avoir ajouté une étape crée
/// une nouvelle commande sur un nouveau rendu, jamais une mise à jour de
/// celle-ci. Sans quoi le carnet livré ne serait pas celui qui a été
/// prévisualisé et payé.
model PrintOrder {
  id       String @id @default(uuid())
  memoId   String
  memo     Memo   @relation(fields: [memoId], references: [id], onDelete: Cascade)
  renderId String
  render   Render @relation(fields: [renderId], references: [id], onDelete: Restrict)

  /// **Qui a commandé.** Le propriétaire ou l'un de ses co-voyageurs : les deux
  /// peuvent commander le carnet, et ce n'est donc pas déductible du voyage.
  ///
  /// C'est aussi la colonne qui dira **quelle cagnotte payer** le jour où la
  /// commande sera encaissée : chacun a la sienne, et celle du propriétaire n'a
  /// pas à régler l'exemplaire d'un autre.
  ///
  /// En `SetNull` : un compte supprimé ne doit pas emporter avec lui une
  /// commande d'un voyage qui, lui, appartient à quelqu'un d'autre.
  orderedByAccountId String?
  orderedBy          Account? @relation("PrintOrderBuyer", fields: [orderedByAccountId], references: [id], onDelete: SetNull)

  status PrintOrderStatus @default(draft)
  copies Int              @default(1)

  /// Le palier d'acheminement facturé. `standard` est inclus dans le prix du
  /// carnet, `express` porte le supplément qu'on lit dans `shippingCents`.
  shippingSpeed ShippingSpeed @default(standard)

  /// La carte présentée au moment de payer. **Nullable et en `SetNull`** : une
  /// carte supprimée du profil ne doit pas emporter la commande qu'elle a
  /// réglée, et une commande passée par Apple Pay n'en a aucune.
  paymentCardId String?
  paymentCard   PaymentCard? @relation(fields: [paymentCardId], references: [id], onDelete: SetNull)

  /// Le suivi par WhatsApp, demandé depuis l'écran de confirmation.
  ///
  /// Le numéro est **recopié ici** plutôt que lu sur le compte à l'envoi :
  /// c'est celui qu'on a promis de prévenir pour *cette* commande, et changer
  /// de numéro dans son profil trois semaines plus tard ne doit pas dérouter le
  /// message vers un téléphone qui n'a rien demandé. Même parti pris que
  /// l'adresse de livraison, figée elle aussi.
  ///
  /// `notifyByWhatsApp` sans `whatsappPhone` ne doit jamais exister : la route
  /// refuse l'un sans l'autre.
  notifyByWhatsApp Boolean @default(false)
  whatsappPhone    String?

  /// Adresse de livraison, telle que saisie dans l'app.
  shippingName       String
  shippingLine1      String
  shippingLine2      String?
  shippingPostalCode String
  shippingCity       String
  shippingCountry    String

  /// Ce que la feuille de suivi montre du carnet commandé. Figé comme le
  /// rendu : c'est le livre qui part à l'impression, pas celui d'aujourd'hui.
  pageCount     Int?
  coverImageUrl String?

  /// Deux bornes plutôt qu'une date : un imprimeur annonce un délai, pas un
  /// rendez-vous.
  estimatedMinDays Int?
  estimatedMaxDays Int?

  /// Renseignés par l'imprimeur une fois la commande partie.
  providerOrderId String?
  carrier         String?
  trackingUrl     String?
  error           String?

  /// Les dates du suivi. Chacune n'est posée qu'une fois, à l'événement qu'elle
  /// nomme : elles racontent l'acheminement mieux que `status`, qui n'en garde
  /// que le dernier état.
  submittedAt DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?

  /// Ce que la commande a coûté, en centimes, et le paiement Stripe
  /// correspondant. L'unicité de l'intention est ce qui empêche qu'un webhook
  /// rejoué fasse payer deux fois.
  ///
  /// `amountCents` est **le net à payer** : les trois colonnes au-dessus s'y
  /// résument par `itemsCents + shippingCents - walletAppliedCents`. On les
  /// garde figées plutôt que recalculables, parce qu'un tarif qui change ne
  /// doit pas réécrire le récapitulatif d'une commande déjà passée.
  itemsCents         Int?
  shippingCents      Int?
  walletAppliedCents Int?

  amountCents           Int?
  stripePaymentIntentId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  walletEntries WalletEntry[]
  copyOptions   PrintOrderCopy[]

  @@index([memoId, createdAt])
  @@index([orderedByAccountId, createdAt])
  @@map("print_orders")
}

/// Les options d'**un** exemplaire d'une commande.
///
/// Une table et non quatre colonnes sur la commande : l'écran des exemplaires
/// laisse offrir le 2e carnet dans une autre version que le 1er, donc les
/// options pendent de l'exemplaire, pas de la commande. C'est aussi ce que
/// l'imprimeur lira — une ligne par livre à fabriquer.
///
/// Les quatre options sont celles de `BookCustomisation`, et elles s'en
/// copient à la commande : changer le style du carnet après coup ne doit pas
/// changer un livre déjà parti à l'impression.
model PrintOrderCopy {
  id      String     @id @default(uuid())
  orderId String
  order   PrintOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Le rang de l'exemplaire, à partir de 1 — « 1er Carnet », « 2e Carnet ».
  position Int

  decorationsEnabled Boolean @default(true)
  quizEnabled        Boolean @default(true)
  freeZonesEnabled   Boolean @default(true)
  crosswordEnabled   Boolean @default(true)

  @@unique([orderId, position])
  @@map("print_order_copies")
}

/// Une écriture de cagnotte. **Registre en ajout seul** : on n'y met jamais à
/// jour ni ne supprime une ligne. Se tromper se corrige par une écriture
/// inverse, comme dans un livre de comptes — c'est ce qui rend l'historique
/// opposable.
///
/// Le solde d'un compte est la somme des `amountCents` de ses écritures.
/// `Account.walletBalanceCents` n'en est qu'un cache, déplacé dans la même
/// transaction que l'insertion.
///
/// Trois règles tiennent la sécurité de l'ensemble :
///
/// 1. **Des centimes entiers.** Aucun montant en flottant, nulle part.
/// 2. **Une écriture par mouvement réellement encaissé.** Il n'y a pas d'état
///    « en attente » : tant que Stripe n'a pas confirmé, rien n'est écrit.
/// 3. **`stripeEventId` unique.** Un webhook rejoué — Stripe les rejoue —
///    échoue sur la contrainte au lieu de créditer deux fois. C'est la base de
///    données qui garantit l'idempotence, pas le code applicatif.
model WalletEntry {
  id        String  @id @default(uuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  /// Signé : positif au crédit, négatif au débit.
  amountCents Int

  /// Le solde du compte après cette écriture. Redondant avec la somme, et c'est
  /// exactement l'intérêt : une dérive entre les deux se voit sans rejouer tout
  /// l'historique.
  balanceAfterCents Int

  kind WalletEntryKind

  /// Motif lisible, affiché dans l'historique de la cagnotte. Obligatoire dans
  /// les faits pour un `adjustment` : une correction sans motif est
  /// invérifiable.
  label String?

  /// L'événement Stripe qui a produit cette écriture. Nul pour un geste
  /// commercial ou une correction, qui ne viennent pas de Stripe.
  stripeEventId String? @unique

  /// La commande que cette écriture paie ou rembourse, le cas échéant.
  printOrderId String?
  printOrder   PrintOrder? @relation(fields: [printOrderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([accountId, createdAt])
  @@map("wallet_entries")
}

/// Une carte enregistrée. **Le numéro complet n'entre jamais ici** : Stripe le
/// détient, cette table n'en garde que de quoi reconnaître la carte à l'écran.
model PaymentCard {
  id        String  @id @default(uuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  /// Le nom que l'utilisateur donne à sa carte : « Carte perso ».
  label    String?
  /// Les quatre derniers chiffres, la marque et l'échéance : tout ce qu'il faut
  /// pour l'afficher, rien de ce qu'il faudrait pour s'en servir.
  last4    String
  brand    String?
  expMonth Int?
  expYear  Int?

  /// Le moyen de paiement chez Stripe. C'est lui, et lui seul, qui permet de
  /// débiter.
  stripePaymentMethodId String @unique

  /// La carte proposée par défaut. Remplace le `selectedCardId` que l'app tient
  /// aujourd'hui de son côté.
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())

  /// Les commandes réglées avec cette carte. En `SetNull` de l'autre côté :
  /// retirer une carte du profil n'efface pas ce qu'elle a payé.
  printOrders PrintOrder[]

  @@index([accountId])
  @@map("payment_cards")
}

/// L'abonnement, tel que la feuille du profil le présente.
/// Les deux paliers de limites de souvenirs.
///
/// Deux et pas trois : la feuille d'extension oppose **ce qu'on a** à **ce qu'on
/// peut avoir**, et un troisième palier transformerait une décision en
/// comparaison de tableau.
enum MemoryPlan {
  /// Le palier compris dans l'abonnement.
  included
  /// Le palier étendu, à 3,99 €/mois.
  extended
}

model Subscription {
  id        String  @id @default(uuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  provider SubscriptionProvider
  status   SubscriptionStatus   @default(active)

  /// En centimes, et la devise à côté : un abonnement se vend aussi hors de la
  /// zone euro, contrairement à la cagnotte.
  priceCents Int
  currency   String @default("EUR")
  /// Le pas de facturation, « week » ou « month ».
  interval   String @default("week")

  /// La référence chez le fournisseur : abonnement Stripe, ou transaction
  /// d'origine StoreKit.
  providerSubscriptionId String? @unique

  startedAt   DateTime  @default(now())
  renewsAt    DateTime?
  cancelledAt DateTime?

  /// Ce que la personne a répondu à « Pourquoi nous quittes-tu ? ».
  ///
  /// **La feuille pose la question pour qu'on y réponde** — son bouton reste
  /// gris tant qu'aucune raison n'est cochée —, et jusqu'au 19/09/2026 la
  /// réponse était jetée : l'app la passait à un modèle qui ne l'envoyait nulle
  /// part. Une des cinq valeurs de `SubscriptionCancellationReason` côté app,
  /// libre ici : c'est une donnée de sondage, pas un état du système, et la
  /// contraindre en énumération obligerait à migrer la base chaque fois que la
  /// question change.
  cancellationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId, status])
  @@map("subscriptions")
}

/// Une application tierce que MemoBook peut interroger pour enrichir un carnet.
model AccountConnector {
  id        String  @id @default(uuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  /// L'identifiant du service. Une chaîne et non une énumération : brancher un
  /// connecteur de plus ne doit pas demander une migration.
  connectorKey String

  isEnabled Boolean @default(false)

  /// Le jeton d'accès, **chiffré au repos**, jamais en clair. C'est la colonne
  /// la plus sensible du schéma : elle ouvre le compte de quelqu'un chez un
  /// tiers. Elle ne sort d'ici que vers l'appel qui l'utilise, jamais vers
  /// l'app.
  accessToken          String?
  refreshToken         String?
  tokenExpiresAt       DateTime?
  /// Le compte tel que le service tiers le nomme, pour l'afficher sans avoir à
  /// l'interroger.
  externalAccountLabel String?

  connectedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  /// Un compte ne branche qu'une fois le même service.
  @@unique([accountId, connectorKey])
  @@map("account_connectors")
}

/// Un carnet de la galerie mis en avant. Le contenu vient du serveur pour
/// qu'une campagne se change **sans mise à jour de l'app**.
model Showcase {
  id       String  @id @default(uuid())
  title    String
  subtitle String?

  imageUrl       String?
  destinationUrl String?

  /// Le carnet de la galerie que cette carte met en avant, quand il y en a un.
  memoId String?

  /// Visible sur la carte de découverte, en bas de l'accueil.
  isActive Boolean @default(false)

  /// Montré sur l'écran de bienvenue, celui qui n'apparaît qu'une fois au
  /// premier lancement. Deux drapeaux distincts et non un seul : un carnet
  /// peut mériter l'accueil sans être ce qu'on montre à quelqu'un qui découvre
  /// l'app, et l'inverse aussi. Ils se basculent depuis la base, sans livrer
  /// de version.
  showOnWelcomeScreen Boolean @default(false)

  /// Ordre d'affichage, du plus petit au plus grand.
  position Int @default(0)

  /// Fenêtre de diffusion. Nulle des deux côtés, la carte est diffusée tant que
  /// son drapeau est levé.
  startsAt DateTime?
  endsAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, position])
  @@index([showOnWelcomeScreen, position])
  @@map("showcases")
}

/// Une demande d'avis, poussée dans l'app **sans livrer de version**.
///
/// L'app ne connaît que les formes de question (`FeedbackQuestionKind`) et sait
/// les dessiner ; le texte, l'ordre, le nombre de questions et le moment de
/// l'affichage viennent d'ici. Ajouter une campagne est une insertion, pas une
/// release.
model FeedbackCampaign {
  id String @id @default(uuid())

  /// Identifiant lisible, celui qu'on cite dans une analyse : `avis-v1`,
  /// `nps-septembre`.
  key String @unique

  /// L'en-tête de la modale.
  title       String
  subtitle    String?
  /// Le libellé du bouton d'envoi.
  submitLabel String  @default("Envoyer")

  isActive Boolean @default(false)

  /// Fenêtre de diffusion.
  startsAt DateTime?
  endsAt   DateTime?

  /// Combien de fois au maximum la proposer à quelqu'un qui l'a écartée. À 1,
  /// une modale fermée ne revient jamais.
  maxDisplays Int @default(1)

  /// Filtre d'audience, évalué côté serveur. Structure libre le temps que les
  /// critères se stabilisent : « a déjà commandé », « inscrit depuis 7 jours ».
  audience Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions FeedbackQuestion[]
  responses FeedbackResponse[]

  @@index([isActive, startsAt])
  @@map("feedback_campaigns")
}

/// Une question d'une campagne.
model FeedbackQuestion {
  id         String           @id @default(uuid())
  campaignId String
  campaign   FeedbackCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  /// Rang dans la modale, de haut en bas.
  position Int

  kind FeedbackQuestionKind

  /// L'intitulé affiché au-dessus du champ. Vide pour une zone de commentaire
  /// qui se contente de son texte d'invite.
  prompt      String?
  /// Le texte grisé d'un champ libre : « Ton commentaire… ».
  placeholder String?

  isRequired Boolean @default(false)

  /// Ce que la forme demande en plus, et rien d'autre :
  ///
  /// - `choice` — `{ "options": [{ "key": "a", "label": "…", "hint": "…" }] }`
  /// - `slider` — `{ "min": 0, "max": 4, "step": 1, "minLabel": "…", "maxLabel": "…" }`
  /// - `rating` — `{ "max": 5 }`
  /// - `text`   — rien.
  ///
  /// Du JSON parce que chaque forme a ses propres réglages : des colonnes
  /// séparées seraient nulles pour toutes les questions sauf une.
  config Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  answers FeedbackAnswer[]

  @@unique([campaignId, position])
  @@map("feedback_questions")
}

/// Ce qu'une personne a fait de la modale : elle l'a remplie, ou elle l'a
/// fermée. Les deux comptent — savoir qu'on écarte une question est un résultat.
model FeedbackResponse {
  id         String           @id @default(uuid())
  campaignId String
  campaign   FeedbackCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  /// Nul pour un avis laissé avant la connexion.
  ///
  /// En cascade, et non anonymisé : un avis est **la donnée de la personne qui
  /// l'a écrit**. Supprimer son compte l'emporte avec le reste, quitte à perdre
  /// une ligne de statistique.
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)

  /// Combien de fois la modale a été montrée à cette personne pour cette
  /// campagne. C'est ce compteur que `maxDisplays` borne.
  displayCount Int @default(1)

  shownAt     DateTime  @default(now())
  submittedAt DateTime?
  dismissedAt DateTime?

  /// La version de l'app qui a affiché la modale : un avis se lit autrement
  /// selon ce que la personne avait sous les yeux.
  appVersion String?

  answers FeedbackAnswer[]

  /// Une ligne par campagne et par personne : la relancer met à jour le
  /// compteur, elle ne crée pas une deuxième ligne.
  @@unique([campaignId, accountId])
  @@index([campaignId, submittedAt])
  @@map("feedback_responses")
}

/// Une réponse à une question.
///
/// Une colonne par type plutôt qu'un JSON fourre-tout : c'est ce qui permet de
/// faire la moyenne d'un curseur ou de compter les choix en SQL, sans
/// désérialiser quoi que ce soit.
model FeedbackAnswer {
  id         String           @id @default(uuid())
  responseId String
  response   FeedbackResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  questionId String
  question   FeedbackQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  /// Rempli pour `text`.
  textValue   String?
  /// Rempli pour `slider` et `rating`.
  numberValue Float?
  /// Rempli pour `choice` : la clé de l'option retenue.
  choiceKey   String?

  createdAt DateTime @default(now())

  @@unique([responseId, questionId])
  @@index([questionId])
  @@map("feedback_answers")
}

/// Les thèmes proposés à la première étape de « Créer un voyage » — « Contexte
/// de ton voyage ».
///
/// **Une table et non une liste dans l'app** : en ajouter, en renommer ou en
/// éteindre un ne demande pas de livrer une version. Arrêtés par Hugo le
/// 14/09/2026, posés par `prisma/tripThemes.ts`.
///
/// Le libellé part **tel quel** dans `memos.theme` : c'est du texte lu par
/// l'agent de rédaction, pas une clé.
model TripTheme {
  id String @id @default(uuid())

  /// L'identifiant stable, celui qu'on écrit dans un script. `name` peut
  /// changer, `slug` non.
  slug String @unique

  /// L'émoji de la rangée, et le nom écrit dessous.
  emoji String
  name  String

  /// « Autre » : le thème qui n'en est pas un et ouvre un champ libre. La route
  /// le sert toujours **en dernier**, quelle que soit sa position — on préfère
  /// un thème précis.
  isOther Boolean @default(false)

  /// Ordre dans la rangée, du plus petit au plus grand.
  position Int @default(0)

  /// Retiré de la rangée sans être supprimé : les voyages qui le citent
  /// gardent un texte qui existe quelque part.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, position])
  @@map("trip_themes")
}
